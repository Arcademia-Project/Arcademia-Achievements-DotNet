<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Arcademia.Achievements</RootNamespace>
    <AssemblyName>Arcademia.Achievements</AssemblyName>
    <NoWarn>CS0649;CS4014</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Arcademia.Achievements</PackageId>
    <Version>1.0.0</Version>
    <Authors>Arcademia</Authors>
    <Description>Unlock achievements registered on the Arcademia manager from any .NET game or tool. On an Arcademia arcade cabinet the launcher shows the toasts and the end-of-game claim QR code; on a developer's own machine it runs in sandbox mode. See the online SDK docs for full usage.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://manager.arcademia.ac/docs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Arcademia-Project/Arcademia-Achievements-DotNet</RepositoryUrl>
    <PackageTags>arcademia;achievements;arcade;godot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
